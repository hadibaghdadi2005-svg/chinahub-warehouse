const fs = require("fs"), path = require("path");
const S = require("./scripts/scan.js");

/* ChinaHub's claimed location, from the 28 Oct import snapshot */
const claimed = new Map();
for(const f of fs.readdirSync("seed").filter(x => x !== "_manifest.json")){
  const j = JSON.parse(fs.readFileSync("seed/" + f, "utf8"));
  if(j.shelf) claimed.set(j.barcode, j.shelf);
}
/* where you actually found them */
const found = new Map(S.readScans(".").map(r => [r.barcode, r.shelf]));
/* current records */
const dir = "reports/loc36/items";
const live = new Map();
for(const f of fs.readdirSync(dir)){
  const j = JSON.parse(fs.readFileSync(path.join(dir, f), "utf8"));
  live.set(f.replace(/\.json$/, ""), j.data || j);
}

/* the shipment code carries the date it was raised: SH + YYYYMMDD */
const shipDate = p => {
  const m = String(p || "").match(/^SH(\d{4})(\d{2})(\d{2})/);
  return m ? m[1] + "-" + m[2] + "-" + m[3] : "";
};
const age = d => d ? Math.round((Date.now() - new Date(d + "T00:00:00Z")) / 86400000) : "";

const rows = [];
for(const [bc, ch] of claimed){
  const it = live.get(bc) || {};
  const real = found.get(bc) || "";
  const cost = (+it.cny ? (+it.cny / 6.1) : (+it.cost || 0)).toFixed(2);
  const date = shipDate(it.parcel);
  rows.push([
    bc,
    ch,
    S.shelfProblem(ch) || "looks valid",
    real || "never found",
    real ? (real.toUpperCase() === ch.toUpperCase() ? "agrees" : "DISAGREES") : "not scanned",
    it.shelf || "",
    it.status || "",
    it.customer || "",
    it.clientId || "",
    it.phone || "",
    it.parcel || "",
    date,
    age(date),
    cost,
    it.paid === true ? "yes" : (it.paid === false ? "NO" : ""),
    it.route || "",
    String(it.name || "").slice(0, 60),
  ]);
}
/* oldest first - those are the ones worth asking about */
rows.sort((a, b) => String(a[11]).localeCompare(String(b[11])));

const header = ["barcode","chinahub location","is it a real shelf?","where you found it",
  "verdict","location in app now","status","client","client id","phone",
  "shipment","shipment date","days old","charged usd","paid","route","item"];
fs.writeFileSync("chinahub-location-check.csv", S.toCsv(header, rows));

console.log("wrote chinahub-location-check.csv  " + rows.length + " rows");
const v = {}; rows.forEach(r => v[r[4]] = (v[r[4]] || 0) + 1);
console.log("verdicts: " + JSON.stringify(v));
const bad = rows.filter(r => r[2] !== "looks valid").length;
console.log("locations that are not a real shelf: " + bad + " of " + rows.length);
console.log("\noldest five:");
rows.slice(0,5).forEach(r => console.log("  " + r[11] + "  " + String(r[12]).padStart(4) +
  "d  " + r[0].padEnd(16) + " claims " + r[1].padEnd(10) + " " + r[7]));
console.log("\nnewest:");
rows.slice(-2).forEach(r => console.log("  " + r[11] + "  " + String(r[12]).padStart(4) +
  "d  " + r[0].padEnd(16) + " claims " + r[1].padEnd(10) + " " + r[7]));
let owed = 0; rows.forEach(r => { if(r[14] === "NO") owed += +r[13]; });
console.log("\nunpaid among them: $" + owed.toFixed(2));
